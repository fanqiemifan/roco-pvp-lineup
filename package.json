{
  "name": "roco-pvp-lineup",
  "version": "1.5.8",
  "private": true,
  "description": "洛克王国世界阵容同步推流 —— 洛克王国赛事推流控制台（Electron + React/Ant Design，免费开源）",
  "author": "463218006@qq.com",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "sync:sprites": "node scripts/sync-spirits-assets.mjs",
    "prebuild": "npm run sync:sprites",
    "build:electron": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run build:renderer && npm run build:electron && electron .",
    "start": "npm run build:renderer && npm run build:electron && electron .",
    "serve:node": "npm run build:renderer && npm run build:electron && node dist-electron/electron/server-entry.js --host 0.0.0.0 --port 9988",
    "build": "npm run build:renderer && npm run build:electron",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ant-design/cli": "^6.5.0",
    "antd": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
